  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
