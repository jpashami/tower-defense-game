# Copy this file to android/keystore.properties and fill it in (see docs/PUBLISHING.md).
# keystore.properties is ignored by git: never commit it, and never share it.
# On Windows, write the path with forward slashes, for example C:/Users/you/pixeltd-upload.jks
storeFile=C:/Users/you/pixeltd-upload.jks
storePassword=the password you chose for the key file
keyAlias=upload
keyPassword=the password you chose for the key
